# Copy to .env and fill in. Never commit .env.
# Gnani — get the key at app.gnani.ai/voice after registering for the challenge.
# You get 5,000 programme credits on registration.
GNANI_API_KEY=PASTE_YOUR_GNANI_KEY_HERE
GNANI_STT_LANG=en-IN
GNANI_TTS_VOICE=Nalini
GNANI_TTS_MODEL=timbre-v2.5
# GNANI_TTS_LANG=hi-IN  # leave empty = auto-detect Hindi (Devanagari) vs Hinglish

# LLM — provider switch. Default groq = safest for the demo.
# groq = Groq only. evon = Evon only, fails if vLLM is down.
# auto  = try Evon first, fall back to Groq automatically if Evon is down.
LLM_PROVIDER=groq
# Groq fallback LLM. Keep your existing key.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=120

# Evon v3.3 (Gnani LLM) — via local vLLM, NOT via a Gnani API key.
# See EVON_SETUP.md. vLLM does not check the key, any non-empty value works.
EVON_BASE_URL=http://localhost:8000/v1
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=evon-local
EVON_ENABLE_THINKING=0
EVON_TEMPERATURE=0.6

# 1 = test the whole pipeline with fake STT/TTS and no keys. 0 = real Gnani.
MOCK_GNANI=0
# 1 = also save mic_input/req_*.wav for debugging. 0 = in-memory only (faster).
SAVE_AUDIO=0
